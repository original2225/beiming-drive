# 凭据
.env
.env.local

# 构建产物
frontend/node_modules
frontend/dist
backend/target

# 运行时数据（容器化后不进仓库，本地开发时也可能产生）
data/pgdata
data/blobs
data/remote

# 本机临时文件
*.log
now-*.png
show-*.png
shot-*.png
*.bak

# 本机调试产物：脚本会把访问令牌写到这里（cache/*.txt），
# 一旦被 `git add -A` 顺手带进仓库，令牌就跟着进历史了。
# 两个已跟踪的模板（rail_style.txt / rail_tpl.txt）用 ! 例外放行，
# 不让这条规则把它们从仓库里「隐形删掉」。
cache/*
!cache/rail_style.txt
!cache/rail_tpl.txt