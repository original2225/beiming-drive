<template>
  <div class="shell">
    <!-- 侧栏 -->
    <aside class="side">
      <div class="side-brand">
        <img src="/whale-flat-128.png" alt="logo" />
        <span>北冥云盘</span>
      </div>

      <nav class="side-nav">
        <div class="nav-item" :class="{ on: route.path === '/' }" @click="$router.push('/')">
          <i class="ic">🗂</i><span>我的文件</span>
        </div>
        <div class="nav-item" :class="{ on: route.path === '/shares' }" @click="$router.push('/shares')">
          <i class="ic">🔗</i><span>我的分享</span>
        </div>
        <div class="nav-item" :class="{ on: route.path === '/downloader' }" @click="$router.push('/downloader')">
          <i class="ic">⤓</i><span>专属下载器</span>
        </div>
      </nav>

      <div class="side-foot">
        <div class="quota">
          <div class="quota-top">
            <span class="muted">存储空间</span>
            <span>{{ usedText }} / {{ quotaText }}</span>
          </div>
          <div class="bar"><div class="bar-in" :style="{ width: pct + '%' }"></div></div>
        </div>
        <div class="side-user">
          <div class="avatar">{{ (me?.nickname || 'U').slice(0, 1) }}</div>
          <div class="who">
            <div class="name">{{ me?.nickname }}</div>
            <div class="mail muted">{{ me?.email }}</div>
          </div>
          <button class="btn btn-sm" @click="logout">退出</button>
        </div>
      </div>
    </aside>

    <!-- 主区 -->
    <main class="main">
      <header class="topbar">
        <div class="crumbs">
          <span class="crumb" @click="goRoot">我的文件</span>
          <template v-for="(c, i) in trail" :key="c.id">
            <span class="sep">/</span>
            <span class="crumb" @click="open(c, true)">{{ c.name }}</span>
          </template>
        </div>
        <div class="top-actions">
          <button class="btn btn-sm" @click="refresh">刷新</button>
          <button class="btn btn-sm" @click="newFolder">新建文件夹</button>
          <label class="btn btn-primary btn-sm upload-btn">
            <input type="file" multiple hidden @change="onPick" />
            上传文件
          </label>
        </div>
      </header>

      <div v-if="loading" class="empty">加载中…</div>

      <div v-else-if="items.length === 0" class="empty">
        这里还空着，点右上角上传文件或新建文件夹
      </div>

      <div v-else class="grid">
        <div v-for="it in items" :key="it.id" class="item card"
             @click="it.kind === 'dir' ? open(it) : null">
          <div class="item-icon" :class="it.kind">{{ it.kind === 'dir' ? '📁' : fileIcon(it.name) }}</div>
          <div class="item-body">
            <div class="item-name" :title="it.name">{{ it.name }}</div>
            <div class="item-meta muted">{{ it.kind === 'dir' ? '文件夹' : sizeText(it.size) }}</div>
          </div>
          <div class="item-ops" @click.stop>
            <button v-if="it.kind === 'file'" class="btn btn-sm" @click="download(it)">下载</button>
            <button class="btn btn-sm" @click="share(it)">分享</button>
            <button class="btn btn-sm btn-danger" @click="remove(it)">删除</button>
          </div>
        </div>
      </div>

      <!-- 上传进度 -->
      <div v-if="uploads.length" class="uploads card">
        <div class="up-title">上传队列</div>
        <div v-for="u in uploads" :key="u.key" class="up-row">
          <div class="up-name">{{ u.name }}</div>
          <div class="up-bar"><div class="up-in" :style="{ width: u.pct + '%' }"></div></div>
          <div class="up-pct">{{ u.pct }}%</div>
        </div>
      </div>
    </main>

    <!-- 分享对话框 -->
    <div v-if="shareBox" class="modal-mask" @click.self="shareBox = null">
      <div class="modal card">
        <h3>分享「{{ shareBox.node.name }}」</h3>
        <label><span>提取码（留空则免密）</span>
          <input class="input" v-model="shareBox.password" placeholder="可选，4-8 位" />
        </label>
        <label><span>有效期（小时，留空永久）</span>
          <input class="input" v-model.number="shareBox.hours" type="number" placeholder="如 24" />
        </label>
        <div v-if="shareBox.result" class="share-out">
          <div class="link-row">
            <input class="input" :value="shareBox.result" readonly @focus="$event.target.select()" />
            <button class="btn btn-sm" @click="copy(shareBox.result)">复制</button>
          </div>
          <p class="muted tip">把这条链接发给对方即可下载</p>
        </div>
        <div class="modal-foot">
          <button class="btn" @click="shareBox = null">关闭</button>
          <button v-if="!shareBox.result" class="btn btn-primary" @click="doShare">创建分享</button>
        </div>
      </div>
    </div>
  </div>
</template>

<script setup>
import { ref, computed, onMounted } from 'vue'
import { useRoute, useRouter } from 'vue-router'
import { api, setToken, downloadUrl } from '../api.js'

const route = useRoute()
const router = useRouter()

const me = ref(null)
const items = ref([])
const loading = ref(false)
const currentId = ref(null)
const trail = ref([])
const uploads = ref([])
const shareBox = ref(null)

const CHUNK = 8 * 1024 * 1024   // 8MiB，和后端默认一致

const pct = computed(() => {
  if (!me.value) return 0
  return Math.min(100, (me.value.storageUsed / me.value.storageQuota) * 100).toFixed(1)
})
const usedText = computed(() => sizeText(me.value?.storageUsed || 0))
const quotaText = computed(() => sizeText(me.value?.storageQuota || 0))

function sizeText(b) {
  if (!b) return '0 B'
  const u = ['B', 'KB', 'MB', 'GB', 'TB']
  let i = 0, n = b
  while (n >= 1024 && i < u.length - 1) { n /= 1024; i++ }
  return `${n.toFixed(n >= 100 || i === 0 ? 0 : 1)} ${u[i]}`
}

function fileIcon(name) {
  const e = (name.split('.').pop() || '').toLowerCase()
  if (['md', 'txt'].includes(e)) return '📄'
  if (['png', 'jpg', 'jpeg', 'gif', 'webp'].includes(e)) return '🖼'
  if (['mp4', 'mkv', 'avi'].includes(e)) return '🎬'
  if (['mp3', 'flac', 'wav'].includes(e)) return '🎵'
  if (['zip', 'rar', '7z', 'tar', 'gz'].includes(e)) return '📦'
  return '📄'
}

async function loadMe() {
  try { me.value = await api.me() } catch (e) { /* 401 会被守卫拦 */ }
}

async function refresh() {
  loading.value = true
  try {
    const d = await api.list(currentId.value)
    items.value = d.items || []
    await loadMe()
  } catch (e) {
    console.warn(e)
  } finally {
    loading.value = false
  }
}

function open(node, jump) {
  currentId.value = node.id
  const i = trail.value.findIndex(t => t.id === node.id)
  if (jump && i >= 0) trail.value = trail.value.slice(0, i + 1)
  else trail.value = [...trail.value, node]
  refresh()
}

function goRoot() {
  currentId.value = null
  trail.value = []
  refresh()
}

async function newFolder() {
  const name = prompt('文件夹名称')
  if (!name) return
  try {
    await api.mkdir(currentId.value, name)
    await refresh()
  } catch (e) { alert(e.message) }
}

// ---- 上传：小文件直传，大文件分片 ----
async function onPick(ev) {
  const files = [...ev.target.files]
  ev.target.value = ''
  for (const f of files) await uploadOne(f)
}

async function uploadOne(file) {
  const key = file.name + '-' + Date.now()
  const rec = { key, name: file.name, pct: 0 }
  uploads.value.push(rec)
  try {
    if (file.size <= CHUNK) {
      await api.uploadSmall(currentId.value, file)
      rec.pct = 100
    } else {
      const total = Math.ceil(file.size / CHUNK)
      const sess = await api.createUpload(currentId.value, file.name, file.size, CHUNK)
      const done = new Set()
      let finished = 0
      const CONC = 3
      let next = 0
      async function worker() {
        while (true) {
          const idx = next++
          if (idx >= total) return
          const start = idx * CHUNK
          const blob = file.slice(start, Math.min(start + CHUNK, file.size))
          await api.putChunk(sess.id, idx, blob)
          done.add(idx)
          finished++
          rec.pct = Math.round((finished / total) * 100)
        }
      }
      await Promise.all(Array.from({ length: Math.min(CONC, total) }, worker))
      await api.completeUpload(sess.id)
      rec.pct = 100
    }
    await refresh()
  } catch (e) {
    rec.pct = -1
    alert(`「${file.name}」上传失败：${e.message}`)
  } finally {
    setTimeout(() => { uploads.value = uploads.value.filter(u => u.key !== key) }, 1800)
  }
}

function download(it) {
  window.open(downloadUrl(it.id), '_blank')
}

async function remove(it) {
  if (!confirm(`把「${it.name}」移入回收站？`)) return
  try { await api.trash(it.id); await refresh() } catch (e) { alert(e.message) }
}

function share(it) {
  shareBox.value = { node: it, password: '', hours: null, result: '' }
}

async function doShare() {
  const s = shareBox.value
  try {
    const r = await api.createShare(s.node.id, s.password || null,
      s.hours || null, null)
    s.result = `${location.origin}/s/${r.share.id}`
  } catch (e) { alert(e.message) }
}

function copy(txt) {
  navigator.clipboard.writeText(txt).then(() => {
    alert('已复制')
  })
}

async function logout() {
  try { await api.logout() } catch (e) {}
  setToken('')
  router.push('/login')
}

onMounted(() => { refresh() })
</script>

<style scoped>
.shell { display: flex; height: 100vh; overflow: hidden; }

/* 侧栏 */
.side {
  width: 232px; flex-shrink: 0; background: #fff; border-right: 1px solid var(--line);
  display: flex; flex-direction: column; padding: 18px 14px;
}
.side-brand { display: flex; align-items: center; gap: 9px; padding: 2px 6px 20px; font-weight: 700; font-size: 15.5px; letter-spacing: .3px; }
.side-brand img { width: 30px; height: 30px; border-radius: 50%; }
.side-nav { display: flex; flex-direction: column; gap: 3px; }
.nav-item {
  display: flex; align-items: center; gap: 10px; padding: 9px 11px;
  border-radius: 9px; font-size: 13.5px; color: var(--ink-2); cursor: pointer; transition: .15s;
}
.nav-item:hover { background: #f6f7fc; }
.nav-item.on { background: var(--brand-soft); color: var(--brand-deep); font-weight: 600; }
.ic { font-style: normal; font-size: 15px; width: 18px; text-align: center; }
.side-foot { margin-top: auto; }
.quota { padding: 12px 10px; background: #f8f9fd; border-radius: 10px; margin-bottom: 12px; }
.quota-top { display: flex; justify-content: space-between; font-size: 11.5px; margin-bottom: 8px; }
.bar { height: 5px; background: #e6e8f0; border-radius: 4px; overflow: hidden; }
.bar-in { height: 100%; background: linear-gradient(90deg, var(--brand), #8b9bff); border-radius: 4px; transition: .3s; }
.side-user { display: flex; align-items: center; gap: 9px; padding: 8px 4px; }
.avatar {
  width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0;
  background: linear-gradient(135deg, var(--brand), #8b5cf6);
  color: #fff; display: grid; place-items: center; font-weight: 600; font-size: 14px;
}
.who { flex: 1; min-width: 0; }
.name { font-size: 13px; font-weight: 600; }
.mail { font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 主区 */
.main { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
.topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16px 26px; border-bottom: 1px solid var(--line); background: #fff;
  gap: 16px;
}
.crumbs { display: flex; align-items: center; gap: 7px; font-size: 14px; min-width: 0; }
.crumb { cursor: pointer; color: var(--ink-2); white-space: nowrap; }
.crumb:hover { color: var(--brand); }
.crumb:last-of-type { color: var(--ink); font-weight: 600; }
.sep { color: var(--ink-3); }
.top-actions { display: flex; gap: 8px; flex-shrink: 0; }
.upload-btn { position: relative; }

.grid {
  padding: 20px 26px; overflow-y: auto; display: grid; gap: 12px;
  grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); align-content: start;
}
.item {
  display: flex; align-items: center; gap: 12px; padding: 12px 14px;
  transition: .16s; cursor: pointer; border: 1px solid transparent;
}
.item:hover { border-color: #dfe3f0; transform: translateY(-1px); box-shadow: 0 4px 16px rgba(22,25,42,.07); }
.item-icon { font-size: 24px; line-height: 1; flex-shrink: 0; width: 34px; text-align: center; }
.item-body { flex: 1; min-width: 0; }
.item-name { font-size: 13.5px; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.item-meta { font-size: 11.5px; margin-top: 3px; }
.item-ops { display: flex; gap: 5px; opacity: 0; transition: .15s; flex-shrink: 0; }
.item:hover .item-ops { opacity: 1; }

.uploads {
  position: fixed; right: 24px; bottom: 24px; width: 320px; padding: 14px 16px; z-index: 50;
}
.up-title { font-size: 12.5px; font-weight: 600; margin-bottom: 10px; color: var(--ink-2); }
.up-row { display: flex; align-items: center; gap: 9px; margin-bottom: 8px; font-size: 12px; }
.up-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.up-bar { width: 90px; height: 4px; background: #e6e8f0; border-radius: 3px; overflow: hidden; }
.up-in { height: 100%; background: var(--brand); transition: .2s; }
.up-pct { width: 34px; text-align: right; color: var(--ink-3); }

/* 模态 */
.modal-mask {
  position: fixed; inset: 0; background: rgba(16,18,32,.38);
  display: grid; place-items: center; z-index: 100; backdrop-filter: blur(2px);
}
.modal { width: 400px; padding: 24px; }
.modal h3 { margin: 0 0 18px; font-size: 16px; }
.modal label { display: block; margin-bottom: 13px; }
.modal label span { display: block; font-size: 12.5px; color: var(--ink-2); margin-bottom: 6px; }
.modal-foot { display: flex; justify-content: flex-end; gap: 8px; margin-top: 18px; }
.share-out { margin-top: 14px; padding-top: 14px; border-top: 1px dashed var(--line); }
.link-row { display: flex; gap: 8px; }
.tip { font-size: 11.5px; margin: 8px 0 0; }
</style>